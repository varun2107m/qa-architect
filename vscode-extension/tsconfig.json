{
  "compilerOptions": {
    "target": "ES2020",

    "module": "NodeNext",

    "moduleResolution": "NodeNext",

    "rootDir": "src",
    "outDir": "dist",

    "strict": true,

    "esModuleInterop": true,

    "types": [
      "node",
      "vscode"
    ],

    "lib": [
      "ES2020",
      "DOM"
    ],

    "sourceMap": true,

    "skipLibCheck": true
  },

  "exclude": [
    "node_modules",
    ".vscode-test"
  ]
}



